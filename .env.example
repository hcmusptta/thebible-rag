GOOGLE_API_KEY=your_google_api_key
LLM_PROVIDERS=ollama
GOOGLE_MODEL=gemini-flash-latest

# Optional local Hugging Face pipeline (not a remote inference API)
HF_API_KEY=
HF_MODEL=
HF_MAX_NEW_TOKENS=512
HF_TEMPERATURE=0.2
HF_TOP_P=0.9
HF_TIMEOUT=60

# Ollama answer model and optional RAGAS judge
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
RAGAS_JUDGE_MODEL=qwen3.5:9b
RAGAS_JUDGE_NUM_CTX=8192
RAGAS_JUDGE_MAX_TOKENS=2048
RAGAS_JUDGE_TEMPERATURE=0
OLLAMA_TEMPERATURE=0
OLLAMA_REASONING=false
LLM_TIMEOUT=120

# Storage and retrieval
CHROMA_DB_PATH=bible_workflow_data
CHROMA_COLLECTION=bible_workflow_v4
EMBEDDING_MODEL_NAME=AITeamVN/Vietnamese_Embedding_v2
EMBEDDING_DIMENSION=1024
# Keep local encoders on CPU to leave GPU memory for Ollama; tune after measuring.
EMBEDDING_DEVICE=cpu
RAGAS_EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding_v2
# Only used when the evaluator embedding model differs from the retrieval model.
RAGAS_EMBEDDING_DEVICE=cpu
RERANKER_MODEL_NAME=AITeamVN/Vietnamese_Reranker
RERANKER_DEVICE=cpu
RERANK_ENABLED=true
RAG_RRF_K=60

RAG_TOP_K=4
RAGAS_SAMPLE_SIZE=25
# Self-authored onboarding set; first ingest samples/onboarding_sample.txt as generic.
GOLDEN_TESTSET_PATH=./golden_testset.json
RAGAS_TOP_K=4
RAG_CANDIDATE_LIMIT=40
RAGAS_CANDIDATE_LIMIT=40
# Full passages are never cut; oversized interpretation asks for narrower scope.
RAG_CONTEXT_MAX_CHARS=40000
# Ollama input and output budgets: oversized requests ask for narrower scope.
OLLAMA_NUM_CTX=16384
RAG_MAX_OUTPUT_TOKENS=2048
# Ingest and non-Scripture summary limits
MAX_PDF_SIZE_MB=100
MAX_PDF_PAGES=3500
CHROMA_READ_BATCH_SIZE=500
CHROMA_ID_BATCH_SIZE=500
EMBEDDING_BATCH_SIZE=50
SUMMARY_MAX_CHARS=120000
SUMMARY_CHUNK_CHARS=12000
